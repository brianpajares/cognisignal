# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=CogniSignal
APP_SLUG=cognisignal
MONETIZATION_MODE=validation
OWNER_EMAIL=owner@example.invalid
ADMIN_EMAILS=admin@example.invalid
CONSENT_VERSION=2026-10-13

# Supabase (server secret must never use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive service account + folder
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
DRIVE_CACHE_TTL_HOURS=24

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Security
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
PII_ENCRYPTION_KEY=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Stripe - only required when MONETIZATION_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_US=
STRIPE_PRICE_GB=
STRIPE_PRICE_ES=
STRIPE_PRICE_BR=
STRIPE_PRICE_MX=
